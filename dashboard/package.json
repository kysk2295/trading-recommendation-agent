{
  "name": "trading-agent-observatory",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/client.ts --outdir public/assets --minify --sourcemap=external",
    "check": "bun run typecheck && bun run lint && bun run test",
    "dev": "bun --hot src/server.ts",
    "lint": "biome check src tests scripts/run-markets-cjk-qa.ts scripts/markets_cjk_fixture.ts scripts/run-options-workbench-qa.ts scripts/options_workbench_qa_support.ts",
    "qa:options-workbench": "bun scripts/run-options-workbench-qa.ts",
    "start": "bun src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.4",
    "hono": "^4.9.8",
    "ky": "^1.10.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.2.2",
    "@types/bun": "^1.2.21",
    "playwright": "^1.62.0",
    "typescript": "^5.9.2"
  }
}
